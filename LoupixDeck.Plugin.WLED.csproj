<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <!-- Produces a .deps.json and copies dependencies next to the plugin DLL
         so the host's AssemblyDependencyResolver can locate them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host at runtime: compile against it but do
         not copy it into the plugin folder. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.33.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Zeroconf" Version="3.7.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin icon, read from the assembly so it does not depend on the install layout. -->
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.WLED.icon.png" Condition="Exists('icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin translations are looked up next to plugin.json. -->
    <None Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
